<?xml version="1.0" encoding="utf-8" ?>
<configuration>

<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
</configSections>
	<log4net debug="true">
		<appender name="AdoNetAppender" type="log4net.Appender.AdoNetAppender">
			<bufferSize value="1" />
			<connectionType value="System.Data.SqlClient.SqlConnection, System.Data, Version=1.0.3300.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
			<!--connectionString value="data source=127.0.0.1;initial catalog=IRLOG;integrated security=false;User ID=IRUserlog;Password=log123456" /-->
			<connectionString value="data source=172.16.0.2;initial catalog=IRLOG;integrated security=false;User ID=IRUserlog;Password=log123456" />
			<commandText value="INSERT INTO LogMystery ([Date],[Thread],[Level],[Logger],[Message],[Exception]) VALUES (@log_date, @thread, @log_level, @logger, @message, @exception)" />
			<parameter>
				<parameterName value="@log_date" />
				<dbType value="DateTime" />
				<layout type="log4net.Layout.RawTimeStampLayout" />
			</parameter>
			<parameter>
				<parameterName value="@thread" />
				<dbType value="String" />
				<size value="255" />
				<layout type="log4net.Layout.PatternLayout">
					<conversionPattern value="%thread" />
				</layout>
			</parameter>
			<parameter>
				<parameterName value="@log_level" />
				<dbType value="String" />
				<size value="50" />
				<layout type="log4net.Layout.PatternLayout">
					<conversionPattern value="%level" />
				</layout>
			</parameter>
			<parameter>
				<parameterName value="@logger" />
				<dbType value="String" />
				<size value="255" />
				<layout type="log4net.Layout.PatternLayout">
					<conversionPattern value="%logger" />
				</layout>
			</parameter>
			<parameter>
				<parameterName value="@message" />
				<dbType value="String" />
				<size value="4000" />
				<layout type="log4net.Layout.PatternLayout">
					<conversionPattern value="%message" />
				</layout>
			</parameter>
			<parameter>
				<parameterName value="@exception" />
				<dbType value="String" />
				<size value="2000" />
				<layout type="log4net.Layout.ExceptionLayout" />
			</parameter>
		</appender>
		<root>
			<level value="DEBUG" />
			<appender-ref ref="AdoNetAppender" />
		</root>
	</log4net>

  <appSettings>

    <!--https://binsur-iplyc:8443/svn/Gaby/-->
    <!--parametros de configuracion del mistery-->
    <add key="MYSTERYIP" value="172.17.10.108"/>
    <add key="ID" value="10"/>
    <add key="MYSTERYNOMBRE" value="MYSTERY CASH 19"/>
    <add key="SERVERPORT" value="1209"/>
    <add key="VIEWERPORT" value="2013"/>
    <add key="PORTBACKUP" value="1301"/>
    <add key="PORTPREMIO" value="1300"/>
    <add key="PORTBB2" value="1210"/>
    <add key="VIEWERIP" value="127.0.0.1"/>
    <add key="BACKUPIP" value="172.17.0.2"/>
    <add key="ONLINEIP" value="172.17.0.2"/>
    <add key="IPMODULOBB2" value="192.168.1.253"/>
    
<!--campo para indicar si la encriptación está activada-->
    <add key="ENCRIPTACIONACTIVADA" value="TRUE"/>

    <!--variable que indica si se usa el módulo BB2 para almacenar datos de configuración-->
    <add key="MODULOBB2ACTIVADO" value="FALSE"/>
    
    <!--variable que indica si estamos en modo Test-->
    <add key="MODOTEST" value="FALSE"/>
        
    <!--multiplicador hasta nuevo sorteo-->
    <add key="MULTIPLICADORHASTANUEVOSORTEO" value="60000"/>
    
    <!--rango del intervalo de tiempo para los sorteos-->
    <add key="VALORINICIALINTERVALOHASTANUEVOSORTEOP0" value="6"/>
    <add key="VALORFINALINTERVALOHASTANUEVOSORTEOP0" value="15"/>
    <add key="VALORINICIALINTERVALOHASTANUEVOSORTEOP1" value="6"/>
    <add key="VALORFINALINTERVALOHASTANUEVOSORTEOP1" value="15"/>
    <add key="VALORINICIALINTERVALOHASTANUEVOSORTEOP2" value="6"/>
    <add key="VALORFINALINTERVALOHASTANUEVOSORTEOP2" value="15"/>

    <!--cantidad de segundos que usa para determinar si hay slots en juego-->
    <add key="MAXSEGENJUEGO" value="35"/>
    <!--cantidad de segundos que usa para determinar si hay slots en condiciones de sortear-->
    <add key="MAXSEGUNDOS_SORTEO" value="5"/>
    <!--tiempo de espera entre escrituras de archivos(milisegundos)-->
    <add key="SLEEPESCRITURADEARCHIVOS" value="10000"/>
    <!--tiempo de espera entre envío de Premios al Servidor(milisegundos)-->
    <add key="SLEEPENVIODEPREMIOS" value="1500000"/>

    <!--unidad de disco dde se guarda el backup-->
    <add key ="UNIDADBACKUP" value="D"/>

    <!--porcentaje de lo apostado que se destina al mistery-->
    <add key="PORCENTAJEAPUESTAPARAPREMIO" value="1"/>

    <!--como se reparte el porcentaje destinado al mistery-->
    <add key="PORCENTAJEPOZO0" value="5"/>
    <add key="PORCENTAJEPOZO1" value="10"/>
    <add key="PORCENTAJEPOZO2" value="15"/>
    
    <!--valor con el cual se inicia el pozo luego de haber salido el premio-->
    <add key="VALORINICIALPOZO0" value="300000"/>
    <add key="VALORINICIALPOZO1" value="50000"/>
    <add key="VALORINICIALPOZO2" value="1000"/>
    
    <!--valor que indica cuánto debe incrementarse el coin in para mover el pozo-->
    <add key="DELTACOININMINIMOPOZO0" value="2000"/> 
    <add key="DELTACOININMINIMOPOZO1" value="1000"/>
    <add key="DELTACOININMINIMOPOZO2" value="667"/>
    
    <!--probabilidad inicial de que salga el pozo-->
    <add key ="PROBABILIDADINICIALPOZO0" value="236"/>
    <add key ="PROBABILIDADINICIALPOZO1" value="952"/>
    <add key ="PROBABILIDADINICIALPOZO2" value="6944"/>

    <!--valor mínimo que debe tener el pozo para comenzar a sortear-->
    <add key="VALORMINIMOSORTEOPOZO0" value="350000"/>
    <add key="VALORMINIMOSORTEOPOZO1" value="55000"/>
    <add key="VALORMINIMOSORTEOPOZO2" value="2500"/>
    
    <!--umbral maximo que puede llegar el pozo para incrementar la probabilidad-->
    <add key="UMBRALMAXIMOINCREMENTOPROBABILIDADPOZO0" value="300000"/>         
    <add key="UMBRALMAXIMOINCREMENTOPROBABILIDADPOZO1" value="50000"/>
    <add key="UMBRALMAXIMOINCREMENTOPROBABILIDADPOZO2" value="10000"/>
    
    <!--porcentaje en en el que incrementamos la probabilidad del pozo-->
    <add key="PORCENTAJEAINCREMENTARPROBABILIDADPOZO0" value="1"/>
    <add key="PORCENTAJEAINCREMENTARPROBABILIDADPOZO1" value="1"/>
    <add key="PORCENTAJEAINCREMENTARPROBABILIDADPOZO2" value="1"/>
    
    <!--valor máximo que puede alcanzar el pozo-->
    <add key="TOPEMAXIMOINCREMENTOPOZO0" value="1509537"/>
    <add key="TOPEMAXIMOINCREMENTOPOZO1" value="802618"/>
    <add key="TOPEMAXIMOINCREMENTOPOZO2" value="200536"/>

<!--padron de Slots que participan del mistery-->
    <!--Formato  UID|IP|Valor de Transmisión en centavos|ApuestaMáxima,...-->
    <add key="SLOTS" value="	
		310863|172.17.2.52|1|1000,
		310864|172.17.2.53|1|1000,
		310865|172.17.2.66|1|1000,
		310866|172.17.2.64|1|1000,
		310867|172.17.2.65|1|1000,
		310868|172.17.2.67|1|1000
	"/>

    <!--semillas para random-->
    <add key="SEED0POZO0" value="64654"/>
    <add key="SEED1POZO0" value="34543"/>
    <add key="SEED2POZO0" value="63424"/>
    <add key="SEED3POZO0" value="64"/>
    <add key="SEED0POZO1" value="6354"/>
    <add key="SEED1POZO1" value="6345345"/>
    <add key="SEED2POZO1" value="646575"/>
    <add key="SEED3POZO1" value="111354"/>
    <add key="SEED0POZO2" value="4564"/>
    <add key="SEED1POZO2" value="6678"/>
    <add key="SEED2POZO2" value="54754"/>
    <add key="SEED3POZO2" value="9456"/>

<!--Conexión a Base de Datos Mystery-->
<add key="ConexionNombre" value="MYSTERY"/>
<add key="DataBaseName" value="IRCASHONLINE"/>
<add key="Password" value="8hYgr/ZJ48T9Xm5MtBJiuMLZFa+vQwR1"/>
<add key="Password65" value="36sIcLUAO1Isw6Zb6wDOfQ=="/>
<add key="PasswordLocal" value="8hYgr/ZJ48T9Xm5MtBJiuMLZFa+vQwR1"/>
<add key="UserName" value="IRUser"/>
<add key="PersistSecurityInfo" value="true"/>
<add key="ServerName" value="172.17.0.2"/>
<add key="Timeout" value="30"/>
<add key="BaseType" value="MSSQL"/>
    



  </appSettings>
</configuration>












